/target
# never commit backups or transactions by accident
*.seedlock
*.psbt
/seedlocker backups/
**/seedlocker backups/
/seedlocker transactions/
**/seedlocker transactions/
# test leftovers: Python caches, and jsdom when installed here for tools/qr_flow_test.py
__pycache__/
*.pyc
/node_modules/
/package.json
/package-lock.json
# files that macOS and Windows leave in folders
.DS_Store
Thumbs.db
# the ready-made programs that tools/build-release.sh makes
/dist/
# the Android app: what android/build-rust.sh makes, and what Android Studio and Gradle make (the signed
# release APK goes to android/app/release/); the Android signing key never belongs here
/android/app/src/main/jniLibs/
/android/app/src/main/java/org/seedlock/ffi/
/android/app/src/main/assets/
/android/app/release/
*.jks
*.keystore
/android/.gradle/
/android/.idea/
/android/.kotlin/
/android/build/
/android/app/build/
/android/local.properties
*.iml
*.apk
*.aab
