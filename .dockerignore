dist
vendor
seedlocker backups
**/seedlocker backups
seedlocker transactions
**/seedlocker transactions
**/*.seedlock
**/*.psbt
**/*.jks
**/*.keystore
**/*.apk
**/*.aab
android/.gradle
android/.idea
android/.kotlin
android/build
android/app/build
android/app/release
android/local.properties
android/app/src/main/jniLibs
android/app/src/main/java/org/seedlock/ffi
android/app/src/main/assets
**/__pycache__
**/*.pyc
node_modules
.git
